<% if (title) { %>
  <h1><%= title %></h1>
<% } else {
  res.redirect('/')
} %>

<%- messages() %>

<% if (bookings && bookings.length > 0) { %>
  <div class="bookings-list">
    <% bookings.forEach(function(booking) { %>
      <div class="booking-card status-<%= booking.status %>">
        <img src="<%= booking.inv_thumbnail %>"
             alt="<%= booking.inv_year %> <%= booking.inv_make %> <%= booking.inv_model %>">
       
        <div class="booking-details">
          <h2><%= booking.inv_year %> <%= booking.inv_make %> <%= booking.inv_model %></h2>
         
          <p><strong>Start Date:</strong> <%= new Date(booking.start_date).toLocaleDateString() %></p>
          <p><strong>End Date:</strong> <%= new Date(booking.end_date).toLocaleDateString() %></p>
          <p><strong>Status:</strong>
            <span class="status-badge <%= booking.status %>">
              <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
            </span>
          </p>
          <p class="booking-date">Booked on: <%= new Date(booking.created_at).toLocaleDateString() %></p>
         
          <% if (booking.status === 'pending' || booking.status === 'confirmed') { %>
            <form action="/booking/cancel" method="post" class="cancel-form">
              <input type="hidden" name="booking_id" value="<%= booking.booking_id %>">
              <button type="submit" class="cancel-btn"
                      onclick="return confirm('Are you sure you want to cancel this booking?')">
                Cancel Booking
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <p class="no-bookings">You have no bookings yet.
    <a href="/favorite">Check your favorites</a> or
    <a href="/inv">browse vehicles</a> to make a reservation!
  </p>
<% } %>