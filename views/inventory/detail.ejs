<% if (title) { %>
  <h1><%= title %></h1>
<% } else {
  res.locals.title = "Vehicle Details"
} %>
<%- grid %>
<% if (locals.loggedin) { %>
  <div class="vehicle-actions">
    <form action="/favorite/add" method="post" class="favorite-form">
      <input type="hidden" name="inv_id" value="<%= vehicleData.inv_id %>">
      <button type="submit" class="favorite-btn">💖 Add to Favorites</button>
    </form>
    <a href="/booking/create/<%= vehicleData.inv_id %>" class="book-now-btn">
     📆 Book This Vehicle
    </a>
  </div>
  <% } else { %>
    <p class="login-prompt">
      <a href="/account/login">Login</a> to add favorites or make a booking.
    </p>
  <% } %>